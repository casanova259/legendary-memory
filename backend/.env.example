# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/livsportz?sslmode=require

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Clerk Authentication & Identity
# Obtain keys at https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_signing_secret

# One-time Secure Admin Bootstrap Secret
# Generate a strong random key: openssl rand -hex 32
ADMIN_BOOTSTRAP_SECRET=change-this-to-a-secure-random-secret-key-32-chars

# Arcjet Security (Rate Limiting, Bot Detection, Shield)
# Obtain your key at https://launch.arcjet.com
ARCJET_KEY=ajkey_your_arcjet_api_key_here
ARCJET_ENV=development
ARCJET_MODE=DRY_RUN

# CORS Configuration (Comma-separated allowed frontend origins)
CLIENT_URL=http://localhost:3000
# In production, set to your production domain(s):
# CLIENT_URL=https://your-frontend-domain.com,http://localhost:3000

# Simulation / Seeding (Optional)
API_URL=http://localhost:8000
BROADCAST=true
DELAY_MS=3000
MATCH_COUNT=10
