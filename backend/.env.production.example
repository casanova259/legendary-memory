# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-production-sample.us-east-2.aws.neon.tech/livsportz?sslmode=require

# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

# Clerk Authentication & Identity (Production Keys)
CLERK_SECRET_KEY=sk_live_your_production_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_live_your_production_clerk_publishable_key
CLERK_WEBHOOK_SECRET=whsec_your_production_clerk_webhook_secret

# One-time Secure Admin Bootstrap Secret
ADMIN_BOOTSTRAP_SECRET=generate-a-strong-random-secret-for-production

# Arcjet Security (Production Live Mode)
ARCJET_KEY=ajkey_your_arcjet_production_key
ARCJET_ENV=production
ARCJET_MODE=LIVE

# CORS Configuration (Strict Production Frontend URL)
CLIENT_URL=https://your-frontend-app.onrender.com
