# ==============================================================================
# LivSportz Backend — Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port and Host (Port 8000 default, or auto-assigned by cloud provider like Render/Railway)
PORT=8000
HOST=0.0.0.0

# Database Configuration (Neon PostgreSQL with SSL)
DATABASE_URL=postgresql://user:password@ep-production-cluster.us-east-2.aws.neon.tech/livsportz?sslmode=require

# Arcjet Production Security (Obtain at https://launch.arcjet.com)
ARCJET_KEY=ajkey_your_production_arcjet_key
ARCJET_ENV=production
ARCJET_MODE=LIVE

# CORS: Set to your exact production frontend domain(s) (comma-separated if multiple)
CLIENT_URL=https://livsportz.vercel.app

# Database Connection Pool Settings
DB_POOL_MAX=20
